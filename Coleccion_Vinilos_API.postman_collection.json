{
	"info": {
		"_postman_id": "c1f2e3d4-a5b6-7c8d-9e0f-1a2b3c4d5e6f",
		"name": "Colección Vinilos API",
		"description": "Endpoints para la API REST de Colección de Vinilos y CD con CodeIgniter 4 y JWT.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8083",
			"type": "string"
		},
		{
			"key": "jwt_token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Autenticación",
			"item": [
				{
					"name": "1. Registrar Usuario",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nombre\": \"Melómano\",\n  \"email\": \"coleccionista@ejemplo.com\",\n  \"password\": \"Password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/register",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"register"
							]
						}
					}
				},
				{
					"name": "2. Iniciar Sesión (Obtener JWT)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set('jwt_token', jsonData.token);",
									"    console.log('Token JWT guardado automáticamente en la colección.');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"coleccionista@ejemplo.com\",\n  \"password\": \"Password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"login"
							]
						}
					}
				}
			]
		},
		{
			"name": "Vinilos",
			"item": [
				{
					"name": "3. Listar todos los Vinilos (Público)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/vinilos",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"vinilos"
							]
						}
					}
				},
				{
					"name": "4. Obtener un Vinilo por ID (Público)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/vinilos/1",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"vinilos",
								"1"
							]
						}
					}
				},
				{
					"name": "5. Crear Vinilo con Fotos (Protegido con JWT)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "titulo",
									"value": "The Dark Side of the Moon",
									"type": "text"
								},
								{
									"key": "artista",
									"value": "Pink Floyd",
									"type": "text"
								},
								{
									"key": "anio_lanzamiento",
									"value": "1973",
									"type": "text"
								},
								{
									"key": "genero",
									"value": "Rock Progresivo",
									"type": "text"
								},
								{
									"key": "formato",
									"value": "12\" LP",
									"type": "text"
								},
								{
									"key": "estado_conservacion",
									"value": "Near Mint (NM)",
									"type": "text"
								},
								{
									"key": "estado_adquisicion",
									"value": "Comprado Usado",
									"type": "text"
								},
								{
									"key": "fecha_adquisicion",
									"value": "2026-05-10",
									"type": "text"
								},
								{
									"key": "precio",
									"value": "45.00",
									"type": "text"
								},
								{
									"key": "fotos[]",
									"type": "file",
									"src": []
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/vinilos",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"vinilos"
							]
						}
					}
				},
				{
					"name": "6. Eliminar Vinilo (Protegido con JWT)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{base_url}}/vinilos/1",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"vinilos",
								"1"
							]
						}
					}
				}
			]
		}
	]
}
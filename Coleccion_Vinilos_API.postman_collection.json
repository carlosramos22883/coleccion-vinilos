{
    "info": {
        "_postman_id": "c1f2e3d4-a5b6-7c8d-9e0f-1a2b3c4d5e6f",
        "name": "Colección Vinilos API",
        "description": "Endpoints para la API REST de Colección de Vinilos y CD con CodeIgniter 4, JWT y RBAC.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:8083",
            "type": "string"
        },
        {
            "key": "jwt_token",
            "value": "",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "Autenticación",
            "item": [
                {
                    "name": "1. Registrar Usuario",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"nombre\": \"Melómano\",\n  \"email\": \"coleccionista@ejemplo.com\",\n  \"password\": \"Password123\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/auth/register",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "register"
                            ]
                        }
                    }
                },
                {
                    "name": "2. Iniciar Sesión (Obtener JWT)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "if (jsonData.token) {",
                                    "    pm.collectionVariables.set('jwt_token', jsonData.token);",
                                    "    console.log('Token JWT guardado automáticamente.');",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"coleccionista@ejemplo.com\",\n  \"password\": \"Password123\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/auth/login",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "login"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Vinilos",
            "item": [
                {
                    "name": "3. Listar / Buscar Vinilos (Público + Filtros)",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/vinilos?buscar=&genero=&formato=&estado_conservacion=&page=1&limit=10",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "vinilos"
                            ],
                            "query": [
                                {
                                    "key": "buscar",
                                    "value": "",
                                    "description": "Busca por título, artista o género"
                                },
                                {
                                    "key": "genero",
                                    "value": "",
                                    "description": "Filtro exacto de género (ej: Grunge, Rock)"
                                },
                                {
                                    "key": "formato",
                                    "value": "",
                                    "description": "Filtro por formato (ej: LP, EP, Single)"
                                },
                                {
                                    "key": "estado_conservacion",
                                    "value": "",
                                    "description": "Filtro por estado de conservación (ej: M, NM, VG+)"
                                },
                                {
                                    "key": "page",
                                    "value": "1"
                                },
                                {
                                    "key": "limit",
                                    "value": "10"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "4. Obtener un Vinilo por ID (Público)",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/vinilos/1",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "vinilos",
                                "1"
                            ]
                        }
                    }
                },
                {

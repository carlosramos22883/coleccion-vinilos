                                },
                                {
                                    "key": "formato",
                                    "value": "LP",
                                    "type": "text"
                                },
                                {
                                    "key": "estado_conservacion",
                                    "value": "NM",
                                    "type": "text"
                                },
                                {
                                    "key": "estado_adquisicion",
                                    "value": "Regalado Nuevo",
                                    "type": "text"
                                },
                                {
                                    "key": "fecha_adquisicion",
                                    "value": "2026-08-22",
                                    "type": "text"
                                },
